<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Firebase (Firestore + Storage) + اختيار الملفات يحتاجان الإنترنت -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- تنبيهات المالك والمشرفين على Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- التسجيل الصوتي المباشر داخل اللوحة والرسائل الصوتيّة في الدردشة -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- مواصلة رفع الدروس بعد مغادرة الشاشة أو إغلاق التطبيق -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- المكالمات الصوتيّة في المحادثات الخاصّة بين المشرفين (WebRTC):
         الخدمة الأماميّة تبقى حيّة أثناء المكالمة، وتوجيه الصوت يحتاج
         MODIFY_AUDIO_SETTINGS، وشاشة الرنين فوق القفل تحتاج
         USE_FULL_SCREEN_INTENT. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- ⛔ لا تحذف هذه الكتلة: Play **يستنتج** عتاداً مطلوباً من الأذونات ما لم
         نُصرّح بخلافه، فيُسقط من قائمة التوافق كل جهاز ينقصه ذلك العتاد.
         `RECORD_AUDIO` تُوجب ميكروفوناً، و`USE_FINGERPRINT` (تدخل من مكتبة
         الاعتماد لا من مانيفستنا) تُوجب حسّاس بصمة — وقد أسقطتا التوافق فعلاً
         عن أجهزة المشرفين في 2026-08-23 حتى رفض Play الإصدار.
         واللوحة لا تلزمها هذه الحسّاسات أصلاً: التسجيل والمكالمة ميزتان
         اختياريّتان، والدخول ببريد Google لا ببصمة. فكلّها `required="false"`،
         والكود يتحقّق من توفّرها عند الاستعمال لا قبله. -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />
    <uses-feature android:name="android.hardware.fingerprint" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera.autofocus" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />
    <uses-feature android:name="android.hardware.location.gps" android:required="false" />
    <uses-feature android:name="android.hardware.wifi" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.screen.portrait" android:required="false" />
    <uses-feature android:name="android.hardware.screen.landscape" android:required="false" />

    <application
        android:name=".AdminApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="${appLabel}"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MinbarAdmin"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- «المشاركة إلى إدارة منبر»: استقبال ملفّات من التطبيقات الأخرى،
                 ثمّ تعرض اللوحة ورقة خيارات (درس صوتي / مجموعة الإدارة /
                 محادثة خاصّة). الصوت أوّلاً، ومعه الصور والفيديو لأنّ الإرسال
                 إلى الدردشة لا يقتصر على الصوت.
                 ⚠️ لا `*/*` هنا: كان يجعل اللوحة هدف مشاركة لكلّ نصّ ورابط،
                 ومشاركة النصّ بلا EXTRA_STREAM تفتح اللوحة بلا ورقة ولا
                 تفسير. الأنواع المحدّدة تمنع ذلك من أصله. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
            <!-- نصّ مشارَك: وجهته «النص المشروح» لدرس (اختيار الدرس ثم المحرر)
                 — صار له مسار معالجة صريح فلا يفتح اللوحة بلا تفسير. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="audio/*" />
                <data android:mimeType="image/*" />
                <data android:mimeType="video/*" />
            </intent-filter>
        </activity>

        <!-- شاشة قصّ الصور: تتطلّب سمة AppCompat (بلاها تنهار فور فتحها)،
             وبشريط علويّ (لا NoActionBar) لأنّ زرّ «تم» يسكن قائمة الشريط —
             بلا شريط لا يظهر أيّ زرّ إتمام إطلاقاً. -->
        <activity
            android:name="com.canhub.cropper.CropImageActivity"
            android:exported="false"
            android:theme="@style/Theme.AppCompat.DayNight"
            tools:replace="android:theme,android:exported" />

        <!-- شاشة المكالمة: تظهر فوق شاشة القفل وتوقظ الشاشة عند الرنين،
             ولا تُترك أثراً في «الأخيرة» بعد انتهاء المكالمة.
             ⚠️ رأسيّة إلزاماً: في الوضع الأفقي تُقصّ أزرار القبول/الرفض خارج
             الشاشة، وتثبيتها رأسيّاً يمنع كذلك إعادة إنشاء الشاشة عند التدوير
             (مصدر عطلَين سابقين في المكالمة الجارية). -->
        <activity
            android:name=".call.CallActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:screenOrientation="portrait"
            android:showWhenLocked="true"
            android:turnScreenOn="true"
            android:taskAffinity=""
            android:theme="@style/Theme.MinbarAdmin" />

        <!-- رفع الدروس يستمرّ في الخلفية عبر WorkManager. -->
        <service
            android:name="androidx.work.impl.foreground.SystemForegroundService"
            android:foregroundServiceType="dataSync"
            tools:node="merge" />

        <!-- دورة حياة WebRTC والصوت أثناء المكالمة. -->
        <service
            android:name=".call.CallService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <service
            android:name=".data.AdminMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- رسائل FCM التي يرسمها النظام (التطبيق في الخلفيّة) لا تمرّ بكود
             الإشعار عندنا، فبلا هذا السطر تسقط على أيقونة المشغّل الملوّنة
             وتظهر مربّعاً أبيض — نفس علّة setSmallIcon. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />

        <!-- فتح مرفقات الدردشة المنزَّلة بتطبيق النظام (نمط واتساب). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:scheme="https" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SENDTO" />
            <data android:scheme="mailto" />
        </intent>
        <intent>
            <action android:name="android.intent.action.DIAL" />
            <data android:scheme="tel" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="*/*" />
        </intent>
    </queries>
</manifest>
