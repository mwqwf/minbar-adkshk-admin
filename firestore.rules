rules_version = '2';

// القواعد المرجعية الوحيدة لمشروع mxqp-8d1e8.
// جميع العمليات الحساسة (المشاهدات، الملاحظات، إنشاء/حسم المساهمات،
// المراجعة الخاصة بالمالك) تمر عبر Cloud Functions وتُحمى أيضاً بـ App Check.
service cloud.firestore {
  match /databases/{database}/documents {
    function ownerEmail() {
      return 'bdalmjydtbwn812@gmail.com';
    }

    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isOwner() {
      return userEmail() == ownerEmail();
    }

    function supervisorDoc() {
      return get(/databases/$(database)/documents/dashboard_admins/$(userEmail()));
    }

    function isSupervisor() {
      return signedIn()
        && userEmail() != ''
        && exists(/databases/$(database)/documents/dashboard_admins/$(userEmail()))
        && supervisorDoc().data.role == 'supervisor'
        && supervisorDoc().data.blocked != true;
    }

    function canManageContent() {
      return isOwner() || isSupervisor();
    }

    // المحتوى المنشور عام للقراءة، وإدارته للمالك والمشرف المعتمد فقط.
    match /categories/{id} {
      allow read: if true;
      allow create, update: if canManageContent();
      allow delete: if false; // deleteCategoryCascade يحذف المراجع خادمياً.
    }

    match /subcategories/{id} {
      allow read: if true;
      allow create, update: if canManageContent();
      allow delete: if false; // deleteSubcategoryCascade يحذف المراجع خادمياً.
    }

    match /books/{id} {
      allow read: if true;
      allow create, update, delete: if canManageContent();
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow create, delete: if false; // createLesson/deleteLesson يضمنان الهوية وتنظيف التخزين.
      allow update: if canManageContent()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
          'createdByUid', 'createdByEmail', 'addedBy', 'createdAt', 'createdAtTs'
        ]);
      // لا توجد زيادة مباشرة للحقل views؛ الدالة incrementLessonView وحدها تفعل ذلك.
    }

    // سجل المشرفين: لا يرى المستخدم إلا سجله، والمالك وحده يدير القائمة.
    match /dashboard_admins/{email} {
      allow get: if isOwner() || (signedIn() && userEmail() == email);
      allow list: if isOwner();
      allow create, delete: if isOwner();
      allow update: if isOwner()
        || (
          signedIn()
          && userEmail() == email
          && resource.data.role == 'supervisor'
          && resource.data.blocked != true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['lastSignedInAt'])
        );
    }

    // رمز مستقل لكل بريد. تكتب Cloud Functions الرمز، والمالك يقرؤه أو يلغيه.
    // الوثيقة current مرآة توافق مؤقتة للنسخ القديمة من تطبيق الإدارة.
    match /dashboard_owner_codes/{email} {
      allow read: if isOwner();
      allow create, update: if false;
      allow delete: if isOwner();
    }

    // المرشح ينشئ طلبه لنفسه، والمشغّل السحابي يكتب النتيجة عبر Admin SDK.
    match /dashboard_code_requests/{email} {
      allow create: if signedIn()
        && userEmail() == email
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(
          ['uid', 'name', 'photoURL', 'createdAt', 'requestedAt'])
        && request.resource.data.uid is string
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 100
        && request.resource.data.photoURL is string
        && request.resource.data.photoURL.size() <= 2048;
      allow get, delete: if signedIn() && userEmail() == email;
      allow list, update: if false;
    }

    match /dashboard_code_verify/{email} {
      allow create: if signedIn()
        && userEmail() == email
        && request.resource.data.keys().hasOnly(['code', 'createdAt'])
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[0-9]{6}$');
      allow get, delete: if signedIn() && userEmail() == email;
      allow list, update: if false;
    }

    // إشعارات التطبيق العام: القراءة عامة، والكتابة خادمية فقط.
    match /notifications/{id} {
      allow read: if true;
      allow write: if false;
    }

    // إعداد تذكير التحديث في التطبيق العام. القراءة عامّة (يقرؤه كل مستخدم
    // مرّة كل ست ساعات ويحفظه محليّاً)، والكتابة للمالك وحده: ضبط حدّ أدنى
    // للإصدار قرارُ إصدارٍ لا قرار محتوى، وخطؤه يُظهر تذكيراً لكل المستخدمين.
    match /app_config/{id} {
      allow read: if true;
      allow write: if isOwner()
        && request.resource.data.keys().hasOnly([
          'latestVersionCode', 'minSupportedVersionCode', 'message', 'storeUrl',
          'updatedAt', 'updatedBy',
        ])
        && request.resource.data.get('latestVersionCode', 0) is int
        && request.resource.data.get('minSupportedVersionCode', 0) is int
        // الحدّ الأدنى لا يتجاوز الأحدث: عكسه يجعل التذكير القويّ دائماً
        // لكل المستخدمين بمن فيهم من على أحدث نسخة.
        && request.resource.data.get('minSupportedVersionCode', 0)
           <= request.resource.data.get('latestVersionCode', 0)
        && request.resource.data.get('message', '') is string
        && request.resource.data.get('message', '').size() <= 300
        && request.resource.data.get('storeUrl', '') is string
        && request.resource.data.get('storeUrl', '').size() <= 512;
    }

    // تنبيهات الإدارة: المالك يرى الكل، والمشرف يرى تنبيهه والعامة فقط.
    match /admin_alerts/{id} {
      allow read: if isOwner()
        || (isSupervisor()
          && (resource.data.email == userEmail() || resource.data.email == ''));
      allow update: if (isOwner()
          || (isSupervisor()
            && (resource.data.email == userEmail() || resource.data.email == '')))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
        && request.resource.data.readBy is list
        && (!('readBy' in resource.data)
          || request.resource.data.readBy.hasAll(resource.data.readBy))
        && userEmail() in request.resource.data.readBy;
      allow delete: if isOwner()
        || (isSupervisor() && resource.data.email == userEmail());
      allow create: if false;
    }

    // صندوق خاص ودائم للمستخدم المجهول: قرارات مساهماته فقط.
    match /user_notifications/{uid}/items/{id} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create: if false;
    }

    // رموز أجهزة الإدارة. لا يعتمد الخادم على role المرسل من العميل؛
    // يعيد التحقق من dashboard_admins قبل كل إرسال.
    match /admin_device_tokens/{uid} {
      allow get: if isOwner() || (signedIn() && request.auth.uid == uid);
      allow list: if isOwner();
      allow create, update: if signedIn()
        && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(
          ['uid', 'email', 'role', 'token', 'platform', 'chatMuted', 'updatedAt', 'updatedAtMs'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.email == userEmail()
        && request.resource.data.role in ['owner', 'supervisor']
        && request.resource.data.token is string
        && request.resource.data.token.size() >= 20
        && request.resource.data.token.size() <= 4096
        && request.resource.data.platform is string
        && request.resource.data.platform.size() <= 20
        && request.resource.data.chatMuted is bool;
      allow delete: if isOwner() || (signedIn() && request.auth.uid == uid);
    }

    // مشرف المجموعة ⭐ دور داخلي للدردشة لا يمنح أي صلاحية في بقية اللوحة.
    function isChatModerator() {
      return canManageContent()
        && exists(/databases/$(database)/documents/admin_chat_members/$(request.auth.uid))
        && get(/databases/$(database)/documents/admin_chat_members/$(request.auth.uid))
          .data.chatRole == 'moderator';
    }

    // مجموعة الإدارة الخاصة: لا يقرأها أو يكتبها إلا المالك والمشرف المعتمد.
    match /admin_chat_messages/{msgId} {
      allow read: if canManageContent();
      allow create: if canManageContent()
        && request.resource.data.keys().hasOnly([
          'senderId', 'senderName', 'senderPhoto', 'type', 'text', 'att',
          'replyTo', 'sentAtMs', 'createdAt', 'deleted', 'deletedBy',
          'hiddenFor', 'reactions', 'listenedBy'
        ])
        && request.resource.data.senderId == request.auth.uid
        && request.resource.data.senderName is string
        && request.resource.data.senderName.size() <= 100
        && request.resource.data.senderPhoto is string
        && request.resource.data.senderPhoto.size() <= 2048
        && request.resource.data.type in ['text', 'image', 'video', 'audio', 'voice', 'file']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 5000
        && request.resource.data.sentAtMs is int
        && request.resource.data.deleted == false
        && request.resource.data.hiddenFor is list
        && request.resource.data.hiddenFor.size() == 0
        && request.resource.data.reactions is map;
      allow update: if canManageContent() && (
        (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['hiddenFor'])
          && request.resource.data.hiddenFor is list
          && request.resource.data.hiddenFor.hasAll(resource.data.hiddenFor)
          && request.resource.data.hiddenFor.size() == resource.data.hiddenFor.size() + 1
          && request.auth.uid in request.resource.data.hiddenFor
        )
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && request.resource.data.reactions is map
          && request.resource.data.reactions.diff(resource.data.reactions)
            .affectedKeys().hasOnly([request.auth.uid])
        )
        // 🎧 تعليم رسالة صوتيّة «مسموعة»: إضافة معرّفي وحدي (arrayUnion).
        // get(..., []) لأنّ الرسائل الأقدم لا تحمل الحقل إطلاقاً.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['listenedBy'])
          && request.resource.data.listenedBy is list
          && request.resource.data.listenedBy.hasAll(resource.data.get('listenedBy', []))
          && request.resource.data.listenedBy.size()
            == resource.data.get('listenedBy', []).size() + 1
          && request.auth.uid in request.resource.data.listenedBy
        )
        || (
          (resource.data.senderId == request.auth.uid || isOwner() || isChatModerator())
          && request.resource.data.deleted == true
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['deleted', 'deletedBy', 'deletedAt', 'text', 'att'])
        )
      );
      allow delete: if isOwner();
    }

    // هويّة المجموعة: الاسم والصورة يعدّلهما أيّ عضو معتمَد (نمط واتساب)،
    // بينما القفل يبقى للمالك وحده والتثبيت له ولمشرف المجموعة ⭐.
    function metaIdentityKeys() {
      return ['name', 'photoUrl', 'photoPath',
        'updatedAt', 'updatedByUid', 'updatedByName'];
    }
    function metaPinKeys() {
      return ['pinned', 'updatedAt', 'updatedByUid', 'updatedByName'];
    }

    match /admin_chat_meta/{docId} {
      allow read: if canManageContent();
      allow create: if isOwner()
        || (canManageContent()
          && request.resource.data.keys().hasOnly(metaIdentityKeys()))
        || (isChatModerator()
          && request.resource.data.keys().hasOnly(metaPinKeys()));
      // ⚠️ الحقول تُقرأ بـ get(key, '') لا بالوصول المباشر: الوثيقة المدموجة
      // قد تخلو من photoUrl (اسم المجموعة يُكتب وحده) أو من الحقلين معاً
      // (أنشأها التثبيت أوّلاً)، والوصول المباشر إلى حقل غائب يُفشل الشرط
      // كلّه فتُرفض كلّ محاولة من مشرف غير المالك بـPERMISSION_DENIED رغم أن
      // الواجهة تعد بأن الاسم والصورة «متاحان لكلّ المشرفين». نفس نمط
      // resource.data.get('listenedBy', []) المستعمل أعلاه.
      allow update: if isOwner()
        || (canManageContent()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(metaIdentityKeys())
          && request.resource.data.get('name', '') is string
          && request.resource.data.get('name', '').size() <= 80
          && request.resource.data.get('photoUrl', '') is string
          && request.resource.data.get('photoUrl', '').size() <= 2048)
        || (isChatModerator()
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(metaPinKeys()));
      allow delete: if isOwner();
    }

    // ─── المحادثات الفرديّة بين المشرفين (خاصّة تماماً) ──────────────
    // لا يصل إليها إلّا طرفاها، وكلاهما يجب أن يكون معتمَداً في اللوحة.
    match /admin_dm_threads/{threadId} {
      // ⚠️ تُعرَّف داخل الكتلة كي يكون threadId في نطاقها (تعريفها خارجها
      // يجعل $(threadId) غير معرَّف فتُرفض كلّ عمليّات الرسائل).
      function dmMembers() {
        return get(/databases/$(database)/documents/admin_dm_threads/$(threadId))
          .data.members;
      }
      function isDmMember() {
        return canManageContent()
          && request.auth.uid in dmMembers();
      }

      allow read: if canManageContent()
        && request.auth.uid in resource.data.members;
      // إنشاء محادثة: المُنشئ طرف فيها، وعضواها اثنان لا أكثر.
      allow create: if canManageContent()
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.auth.uid in request.resource.data.members;
      allow update: if canManageContent()
        && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;
      // حذف المحادثة كاملةً — لطرفَيها وحدهما (نظير «حذف المحادثة» في
      // واتساب). لا سجلّ يُحفظ: المحادثة الخاصّة ملك طرفيها.
      // ⚠️ يُحذف بعد رسائلها لا قبلها: قاعدة الرسالة تقرأ `members` من هذه
      // الوثيقة، فحذفها أوّلاً يقفل الباب على مجموعتها الفرعيّة إلى الأبد.
      allow delete: if canManageContent()
        && request.auth.uid in resource.data.members;

      match /messages/{msgId} {
        allow read: if isDmMember();
        allow create: if isDmMember()
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in
            ['text', 'image', 'video', 'audio', 'voice', 'file', 'call']
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000
          && request.resource.data.sentAtMs is int
          && request.resource.data.deleted == false
          && request.resource.data.hiddenFor is list
          && request.resource.data.hiddenFor.size() == 0;
        allow update: if isDmMember() && (
          (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['hiddenFor'])
            && request.resource.data.hiddenFor.hasAll(resource.data.hiddenFor)
            && request.auth.uid in request.resource.data.hiddenFor
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['reactions'])
            && request.resource.data.reactions.diff(resource.data.reactions)
              .affectedKeys().hasOnly([request.auth.uid])
          )
          // 🎧 تعليم رسالة صوتيّة «مسموعة» (نظير قاعدة المجموعة تماماً).
          || (
            request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['listenedBy'])
            && request.resource.data.listenedBy is list
            && request.resource.data.listenedBy
              .hasAll(resource.data.get('listenedBy', []))
            && request.resource.data.listenedBy.size()
              == resource.data.get('listenedBy', []).size() + 1
            && request.auth.uid in request.resource.data.listenedBy
          )
          || (
            // الحذف عند الطرفين لصاحب الرسالة وحده.
            resource.data.senderId == request.auth.uid
            && request.resource.data.deleted == true
            && request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['deleted', 'deletedBy', 'deletedAt', 'text', 'att'])
          )
        );
        // يُسمح بالحذف لطرفَي المحادثة وحدهما، وهو مسار «حذف المحادثة
        // كاملةً» لا غير: الرسالة الواحدة تُحذف بالتعليم (`deleted`) كي
        // يبقى أثرها «تم حذف هذه الرسالة» عند الطرف الآخر.
        allow delete: if isDmMember();
      }
    }

    // ─── المكالمات الصوتيّة بين المشرفين (إشارات WebRTC) ───────────────
    // وثيقة لكلّ مكالمة + مجموعتا ICE candidates. لا يصل إليها إلّا طرفاها
    // وكلاهما مشرف معتمَد، والحذف ممنوع تماماً (سجلّ المكالمات).
    match /admin_calls/{callId} {
      // ⚠️ تُعرَّف داخل الكتلة كي يكون callId في نطاقها (نظير dmMembers).
      function callData() {
        return get(/databases/$(database)/documents/admin_calls/$(callId))
          .data;
      }
      function callMembers() {
        return callData().members;
      }
      function isCallMember() {
        return canManageContent()
          && request.auth.uid in callMembers();
      }

      allow read: if canManageContent()
        && request.auth.uid in resource.data.members;
      // إنشاء المكالمة: المُنشئ هو المتّصل، وطرفاها اثنان كلاهما في members،
      // وتبدأ رنيناً دائماً (لا يجوز إنشاء مكالمة «مقبولة» ابتداءً).
      allow create: if canManageContent()
        && request.resource.data.keys().hasOnly([
          'members', 'callerId', 'callerName', 'callerPhoto',
          'calleeId', 'calleeName', 'status', 'createdAtMs', 'createdAt', 'offer',
        ])
        && request.resource.data.members is list
        && request.resource.data.members.size() == 2
        && request.resource.data.callerId is string
        && request.resource.data.calleeId is string
        && request.resource.data.callerId != request.resource.data.calleeId
        && request.resource.data.members.hasAll([
          request.resource.data.callerId,
          request.resource.data.calleeId,
        ])
        && request.auth.uid == request.resource.data.callerId
        && request.resource.data.callerName is string
        && request.resource.data.callerName.size() <= 100
        && request.resource.data.callerPhoto is string
        && request.resource.data.callerPhoto.size() <= 2048
        && request.resource.data.calleeName is string
        && request.resource.data.calleeName.size() <= 100
        && request.resource.data.status == 'ringing'
        && request.resource.data.createdAtMs is int
        && request.resource.data.createdAt == request.time
        && request.resource.data.offer is map
        && request.resource.data.offer.keys().hasOnly(['type', 'sdp'])
        && request.resource.data.offer.type == 'offer'
        && request.resource.data.offer.sdp is string
        && request.resource.data.offer.sdp.size() <= 500000;
      /** الحالات النهائيّة: لا تحديث بعدها إطلاقاً. */
      function callIsFinal() {
        return resource.data.status in ['declined', 'ended', 'missed', 'busy'];
      }
      function callTouched() {
        return request.resource.data.diff(resource.data).affectedKeys();
      }

      allow update: if canManageContent()
        && request.auth.uid in resource.data.members
        && !callIsFinal()
        && (
          // الجواب والقبول عمليّة ذريّة يملكها المستقبِل وحده.
          (
            resource.data.status == 'ringing'
            && request.auth.uid == resource.data.calleeId
            && callTouched().hasOnly(['answer', 'status', 'answeredAtMs'])
            && request.resource.data.status == 'accepted'
            && request.resource.data.answer is map
            && request.resource.data.answer.keys().hasOnly(['type', 'sdp'])
            && request.resource.data.answer.type == 'answer'
            && request.resource.data.answer.sdp is string
            && request.resource.data.answer.sdp.size() <= 500000
            && request.resource.data.answeredAtMs is int
          )
          // الرفض والانشغال للمستقبِل فقط، والفائتة للمتّصل فقط.
          || (
            resource.data.status == 'ringing'
            && request.auth.uid == resource.data.calleeId
            && request.resource.data.status in ['declined', 'busy']
            && callTouched().hasOnly(['status', 'endedAtMs', 'endedBy'])
            && request.resource.data.endedAtMs is int
            && request.resource.data.endedBy == request.auth.uid
          )
          || (
            resource.data.status == 'ringing'
            && request.auth.uid == resource.data.callerId
            && request.resource.data.status == 'missed'
            && callTouched().hasOnly(['status', 'endedAtMs', 'endedBy'])
            && request.resource.data.endedAtMs is int
            && request.resource.data.endedBy == request.auth.uid
          )
          // أيّ طرف يستطيع إنهاء الرنين أو المكالمة المقبولة.
          || (
            resource.data.status in ['ringing', 'accepted']
            && request.resource.data.status == 'ended'
            && callTouched().hasOnly(['status', 'endedAtMs', 'endedBy'])
            && request.resource.data.endedAtMs is int
            && request.resource.data.endedBy == request.auth.uid
          )
        );
      allow delete: if false;

      match /callerCandidates/{candidateId} {
        allow read: if isCallMember();
        allow create: if isCallMember()
          && request.auth.uid == callData().callerId
          && request.resource.data.keys().hasOnly([
            'sdpMid', 'sdpMLineIndex', 'candidate', 'createdAtMs',
          ])
          && request.resource.data.sdpMLineIndex is int
          && request.resource.data.candidate is string
          && request.resource.data.candidate.size() <= 5000
          && request.resource.data.createdAtMs is int;
        allow update, delete: if false;
      }

      match /calleeCandidates/{candidateId} {
        allow read: if isCallMember();
        allow create: if isCallMember()
          && request.auth.uid == callData().calleeId
          && request.resource.data.keys().hasOnly([
            'sdpMid', 'sdpMLineIndex', 'candidate', 'createdAtMs',
          ])
          && request.resource.data.sdpMLineIndex is int
          && request.resource.data.candidate is string
          && request.resource.data.candidate.size() <= 5000
          && request.resource.data.createdAtMs is int;
        allow update, delete: if false;
      }
    }

    match /admin_chat_members/{memberUid} {
      allow read: if canManageContent();
      allow create: if isOwner()
        || (
          isSupervisor()
          && request.auth.uid == memberUid
          && request.resource.data.email == userEmail()
          && request.resource.data.role == 'supervisor'
          && !('chatRole' in request.resource.data)
        );
      allow update: if isOwner()
        || (
          isSupervisor()
          && request.auth.uid == memberUid
          && request.resource.data.email == userEmail()
          && request.resource.data.role == 'supervisor'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'name', 'email', 'photo', 'customName', 'customPhoto',
            'customPhotoPath', 'profileSet', 'lastSeenAt', 'lastActiveAtMs',
            'lastReadAtMs', 'typingAtMs', 'joinedAt'
          ])
        );
      allow delete: if isOwner()
        || (canManageContent() && request.auth.uid == memberUid);
    }

    // ينشئها sendFeedback فقط؛ لا يستطيع العميل تزوير uid أو التوقيت.
    match /feedback/{id} {
      allow create: if false;
      allow read, delete: if canManageContent();
      allow update: if false;
    }

    // الإرسال اليدوي صار عبر sendNotification فقط.
    match /broadcast/{id} {
      allow read, write: if false;
    }

    // بيانات المساهمة تُنشأ وتُحسم عبر callables. يسمح لصاحبها بتحديث
    // رمز جهازه فقط ما دامت معلقة، كي تظل نتيجة المراجعة قابلة للوصول إليه.
    match /lesson_submissions/{submissionId} {
      allow read: if canManageContent()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, delete: if false;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken'])
        && request.resource.data.fcmToken is string
        && request.resource.data.fcmToken.size() <= 4096;
    }

    // النص المشروح المعتمد (المتن المرافق للصوتية): وثيقة لكل درس بمعرّفه.
    // القراءة عامة، والكتابة عبر approveTranscriptSubmission/upsertLessonTranscript
    // حصراً حتى تمر بالتحقق والتدقيق وتوليد روابط الصور.
    match /lesson_transcripts/{lessonId} {
      allow read: if true;
      allow write: if false;
    }

    // اقتراحات المستمعين للنص المشروح: نفس دورة lesson_submissions تماماً —
    // تُنشأ وتُحسم عبر callables، وصاحبها يحدّث رمز جهازه فقط ما دامت معلقة.
    match /transcript_submissions/{submissionId} {
      allow read: if canManageContent()
        || (signedIn() && resource.data.uid == request.auth.uid);
      allow create, delete: if false;
      allow update: if signedIn()
        && resource.data.uid == request.auth.uid
        && resource.data.status == 'pending'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['fcmToken'])
        && request.resource.data.fcmToken is string
        && request.resource.data.fcmToken.size() <= 4096;
    }

    // 🗑️ سلة المحذوفات: الدروس المحذوفة تبقى 30 يوماً قابلة للاستعادة.
    // القراءة للمشرفين، والكتابة عبر الدوال حصراً (النقل/الاستعادة/الحذف
    // النهائي كلها معاملات خادمية).
    match /deleted_lessons/{lessonId} {
      allow read: if canManageContent();
      allow write: if false;
    }

    // قائمة الدروس المشبوهة سرية تماماً عن بقية المشرفين.
    match /owner_lesson_reviews/{reviewId} {
      allow read: if isOwner();
      allow write: if false;
    }

    // سجلات التدقيق مرئية للمالك فقط، وتكتبها الخوادم فقط.
    match /owner_audit_logs/{id} {
      allow read: if isOwner();
      allow write: if false;
    }

    // حدود المعدّل وبيانات منع الإساءة داخلية بالكامل.
    match /private_rate_limits/{id} {
      allow read, write: if false;
    }

    // عداد الأجهزة القديم: قراءة فقط للتوافق مع لوحة الإحصاءات.
    match /devices/{id} {
      allow read: if true;
      allow write: if canManageContent();
    }

    // نظام كلمات المرور النصية القديم مغلق نهائياً.
    match /admins/{id} {
      allow read, write: if false;
    }

    // لا تمنح أي مجموعة مستقبلية صلاحية ضمنية.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
