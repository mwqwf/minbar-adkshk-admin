rules_version = '2';

// القواعد المرجعية لتخزين مشروع mxqp-8d1e8.
// ملفات المساهمات المعلقة خاصة، بينما ملفات الدروس والكتب المنشورة عامة.
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return signedIn() && request.auth.token.email != null
        ? request.auth.token.email.lower()
        : '';
    }

    function isOwner() {
      return userEmail() == 'bdalmjydtbwn812@gmail.com';
    }

    function isSupervisor() {
      return signedIn()
        && userEmail() != ''
        && firestore.exists(/databases/(default)/documents/dashboard_admins/$(userEmail()))
        && firestore.get(/databases/(default)/documents/dashboard_admins/$(userEmail())).data.role == 'supervisor'
        && firestore.get(/databases/(default)/documents/dashboard_admins/$(userEmail())).data.blocked != true;
    }

    function canManageContent() {
      return isOwner() || isSupervisor();
    }

    function validAudio() {
      return request.resource.size > 0
        && request.resource.size <= 100 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('audio/.*');
    }

    function validBook() {
      return request.resource.size > 0
        && request.resource.size <= 50 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    function validImage() {
      return request.resource.size > 0
        && request.resource.size <= 10 * 1024 * 1024
        && request.resource.contentType != null
        && request.resource.contentType.matches('image/.*');
    }

    // المسار الحالي للتطبيق العام: submissions/{uid}/{submissionId}/{fileName}
    match /submissions/{uid}/{submissionId}/{fileName} {
      allow read: if canManageContent() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn()
        && request.auth.uid == uid
        && validAudio();
      allow update: if false;
      allow delete: if canManageContent()
        || (
          signedIn()
          && request.auth.uid == uid
          && (
            !firestore.exists(/databases/(default)/documents/lesson_submissions/$(submissionId))
            || firestore.get(/databases/(default)/documents/lesson_submissions/$(submissionId)).data.status == 'pending'
          )
        );
    }

    // دعم آمن للمسارات القديمة داخل مجلد المستخدم نفسه.
    match /submissions/{uid}/{allPaths=**} {
      allow read: if canManageContent() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn()
        && request.auth.uid == uid
        && validAudio();
      allow update: if false;
      allow delete: if canManageContent();
    }

    match /lessons/{allPaths=**} {
      allow read: if true;
      allow create, update: if canManageContent() && validAudio();
      allow delete: if canManageContent();
    }

    // 🕌 صفحات المصحف المصوَّر الملوّن — ملفّات مجمع الملك فهد الرسميّة
    // (حفص ١٤٤١، ورش ١٤٤٢، قالون ١٤٤٣)، مرفوعةٌ مرّة واحدة من جهاز المالك.
    //
    // **القراءة عامّة** لأنّ التطبيق يجلبها بلا تسجيل دخول (كصور الدروس)،
    // و**الكتابة ممنوعة من العميل بالكامل**: هذه أصول ثابتة لا يرفعها أحد من
    // داخل التطبيق، فلا داعي لفتح ثغرة كتابةٍ لا تُستعمل. تحديثها يقع من
    // جهاز المالك بأداة سطر الأوامر لا من التطبيق.
    match /quran/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }

    // صور صفحات الكتاب المرفقة باقتراح نص مشروح (خاصة بصاحبها والمشرفين).
    match /transcript_submissions/{uid}/{submissionId}/{fileName} {
      allow read: if canManageContent() || (signedIn() && request.auth.uid == uid);
      allow create: if signedIn()
        && request.auth.uid == uid
        && validImage();
      allow update: if false;
      allow delete: if canManageContent()
        || (
          signedIn()
          && request.auth.uid == uid
          && (
            !firestore.exists(/databases/(default)/documents/transcript_submissions/$(submissionId))
            || firestore.get(/databases/(default)/documents/transcript_submissions/$(submissionId)).data.status == 'pending'
          )
        );
    }

    // 📮 مرفقات قناة التواصل مع المالك: تسجيل صوتي أو صور داخل محادثة.
    // المستخدم يرفع في مجلّده وحده، والقراءة له وللمالك فقط (لا للمشرفين —
    // هذه القناة بين المستمع والمالك خاصّةً). الحذف يتمّ خادميّاً في
    // deleteMySupportThread، ويبقى للمالك وللمرسِل ما لم يُحذف الخيط.
    function validSupportFile() {
      return request.resource.size > 0
        && request.resource.contentType != null
        && (
          (request.resource.contentType.matches('image/.*')
            && request.resource.size <= 10 * 1024 * 1024)
          || (request.resource.contentType.matches('audio/.*')
            && request.resource.size <= 25 * 1024 * 1024)
        );
    }

    match /support/{uid}/{threadId}/{fileName} {
      allow read: if isOwner() || (signedIn() && request.auth.uid == uid);
      // ⚠️ المالك يكتب هنا أيضاً: ردّه على المحادثة قد يكون صوتاً أو صورة،
      // ومرفقاته تسكن مساحة صاحب الخيط نفسها كي تُحذف معه حذفاً واحداً.
      // قصرُ الكتابة على `request.auth.uid == uid` كان يمنع المالك من الردّ
      // بمرفق أصلاً — ومعرّفه لا يساوي معرّف صاحب الخيط بحال.
      allow create: if validSupportFile()
        && (isOwner() || (signedIn() && request.auth.uid == uid));
      allow update: if false;
      allow delete: if isOwner() || (signedIn() && request.auth.uid == uid);
    }

    // صور النص المشروح المعتمد: عامة للقراءة، ويرفعها المشرفون مباشرة عبر SDK
    // قبل استدعاء upsertLessonTranscript (الخادم يتحقق ويولّد الروابط).
    match /lesson_transcripts/{lessonId}/{fileName} {
      allow read: if true;
      allow create, update: if canManageContent() && validImage();
      allow delete: if canManageContent();
    }

    match /books/{allPaths=**} {
      allow read: if true;
      allow create, update: if canManageContent() && validBook();
      allow delete: if canManageContent();
    }

    // مرفقات مجموعة الإدارة وصور الأعضاء/المجموعة ومرفقات المحادثات
    // الفرديّة (admin_chat/dm/...). تبقى خاصّة بالحسابات المعتمدة، ولا
    // يراها تطبيق منبر العام أو المستخدمون المجهولون.
    // ملاحظة: التطبيق ينزّل هذه الملفّات عبر Firebase SDK بهويّة المستخدم
    // (writeToFile) لا عبر رابط عامّ — فتُطبَّق هذه القاعدة فعليّاً.
    // ⚠️ القراءة هنا **لا** تعتمد على isSupervisor(): تلك الدالّة تنفّذ نداءً
    // عابراً للخدمات إلى Firestore، وهو ينجح للمالك (فحص رمز محض) ويفشل أو
    // يتأخّر لكثير من المشرفين (صلاحية IAM لحساب خدمة التخزين، تأخّر انتشار،
    // اختلاف حالة أحرف معرّف الوثيقة، أو شبكة ضعيفة أثناء التقييم) — وهذا
    // سبب شكوى «الصوتيات لا تُفتح» عند غير المالك.
    // البديل الصلب: السماح بالقراءة لكلّ من سجّل الدخول بحساب Google (وهو
    // طريق الإدارة الوحيد)، واستبعاد الدخول المجهول الذي يستعمله التطبيق
    // العام. المسارات غير قابلة للتخمين، والروابط الموقَّعة لا تُقرأ إلا من
    // وثائق تحميها قواعد Firestore. الكتابة والحذف تبقيان للمعتمَدين فقط.
    function isGoogleAdminSession() {
      return signedIn()
        && request.auth.token.firebase.sign_in_provider == 'google.com'
        && userEmail() != '';
    }

    match /admin_chat/{allPaths=**} {
      allow read: if isGoogleAdminSession() || canManageContent();
      allow create, update: if canManageContent()
        && request.resource.size > 0
        && request.resource.size <= 250 * 1024 * 1024;
      allow delete: if canManageContent();
    }

    // مسارات نشر قديمة محتملة؛ لا تسمح بالكتابة العامة.
    match /audio/{allPaths=**} {
      allow read: if true;
      allow write: if canManageContent();
    }

    match /pdfs/{allPaths=**} {
      allow read: if true;
      allow write: if canManageContent();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
